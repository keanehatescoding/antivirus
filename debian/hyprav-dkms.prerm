#!/bin/sh
set -e

# See hyprav-dkms.postinst for why this queries dpkg directly instead
# of globbing /usr/src/hyprav-av-*/. dpkg never unpacks/registers a
# new version before prerm runs - even the "upgrade" case runs against
# the OLD package before the new one is unpacked - so hyprav-dkms's
# own Version field in dpkg's database always names exactly the
# version being removed/replaced here, regardless of how many
# /usr/src/hyprav-av-<version>/ directories happen to exist.
# Captured separately from the sed normalization below - piping
# straight into sed would make the pipeline's exit status sed's (which
# succeeds even on empty input), silently hiding a dpkg-query failure
# behind a plain empty DKMS_VER.
DKMS_FULL_VER=$(dpkg-query -W -f='${Version}' hyprav-dkms 2>/dev/null) || DKMS_FULL_VER=""
DKMS_VER=$(echo "$DKMS_FULL_VER" | sed -E 's/^[0-9]+://; s/-[^-]+$//')

if [ -z "$DKMS_VER" ]; then
    echo "hyprav-dkms: could not determine package version via dpkg-query; skipping dkms removal" >&2
fi

case "$1" in
    remove|deconfigure|upgrade)
        # Also on upgrade: this runs against the OLD version's
        # /usr/src/hyprav-av-<version>/ before dpkg unpacks the new
        # one, so skipping "upgrade" here would leave a stale dkms
        # registration behind every time the package version changes.
        if [ -n "$DKMS_VER" ]; then
            dkms remove -m hyprav-av -v "$DKMS_VER" --all || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
