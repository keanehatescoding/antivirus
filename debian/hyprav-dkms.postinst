#!/bin/sh
# Same dkms add/build/install dance as packaging/arch/hyprav-dkms.install
# (manual maintainer-script version, not dh_dkms - see debian/rules).
#
# The version isn't hardcoded here - maintainer scripts are static
# files, not templated by debhelper, so it's derived at runtime - from
# dpkg's own package database, not by globbing
# /usr/src/hyprav-av-*/. That directory can (transiently, e.g. after a
# failed/partial upgrade) hold more than one version, and `ls -d ... |
# head -n1` picked whichever one the filesystem/locale order happened
# to return first, not necessarily the version actually being
# configured here. By the time postinst runs, dpkg has already
# unpacked and registered the new version, so hyprav-dkms's own
# Version field always names exactly the version this invocation is
# for. Strip the epoch and Debian revision the same way
# /usr/share/dpkg/pkg-info.mk derives DEB_VERSION_UPSTREAM at build
# time (which is what named the /usr/src/hyprav-av-<version>/
# directory in the first place), so the two stay in sync.
set -e

DKMS_VER=$(dpkg-query -W -f='${Version}' hyprav-dkms 2>/dev/null | \
    sed -E 's/^[0-9]+://; s/-[^-]+$//')

case "$1" in
    configure)
        if [ -n "$DKMS_VER" ]; then
            dkms add -m hyprav-av -v "$DKMS_VER" || true
            dkms autoinstall -m hyprav-av -v "$DKMS_VER" || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
