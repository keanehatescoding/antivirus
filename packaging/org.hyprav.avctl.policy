<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  org.hyprav.avctl.policy - polkit action for avctl's privileged
  operations (signature/trust/protected-path/policy writes, on-demand
  scan, quarantine restore/delete). Used as: pkexec avctl <verb> ...

  One action, not one per verb - avctl already IS the single trusted
  entry point for every privileged write this project has (the
  /proc-backed ones directly, scan/quarantine via avd's control
  socket - see docs/avd-socket-protocol.md); avd itself independently
  re-checks the caller's uid via SO_PEERCRED for its own three
  privileged verbs (see handle_control_line() in userspace/avd/avd.c),
  so this policy isn't the only gate either way. Splitting this into
  per-verb actions later (e.g. "scan" vs. "modify trust list" vs.
  "restore quarantine") is a reasonable future refinement once this
  single action has seen real use - not done up front, matching this
  project's own habit of shipping the simple version first.

  auth_admin (not auth_admin_keep): re-prompt every time rather than
  caching authorization for a grace period - these are infrequent,
  security-relevant actions (killing/quarantining/restoring files,
  changing what's trusted), where re-prompting is the safer default.

  @BINDIR@ below is a template placeholder (matches packaging/
  avd.service's own convention) rendered by userspace/avctl/Makefile's
  install target via sed - this file as checked in is not something
  polkit can load directly.
-->
<policyconfig>
  <vendor>HyprAV</vendor>
  <vendor_url>https://github.com/keanehatescoding/HyprAV</vendor_url>

  <action id="org.hyprav.avctl.manage">
    <description>Manage HyprAV signatures, trust list, protected paths, policy, on-demand scans, and quarantine</description>
    <message>Authentication is required to change HyprAV's configuration or quarantine state</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@BINDIR@/avctl</annotate>
  </action>
</policyconfig>
